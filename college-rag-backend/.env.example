# Set MOCK_AZURE=true to run locally with in-memory search/LLM/embeddings and sample multilingual corpus
MOCK_AZURE=true
ENVIRONMENT=local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# Azure OpenAI (used when MOCK_AZURE=false)
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
QUERY_MODEL=gpt-4o-mini
GENERATION_MODEL=gpt-4o-mini
GENERATION_TEMPERATURE=0.0
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Azure AI Search (Free / Basic tier compatible)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=college-docs-index
RERANKER=none
RELEVANCE_THRESHOLD=0.40
FAITHFULNESS_CHECK=false

# Azure Blob Storage (source of truth for documents)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
BLOB_CONTAINER=college-docs

# Optional OCR via Azure AI Document Intelligence
OCR_ENABLED=false
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_API_KEY=

# Persistence (sqlite for local dev, cosmos for production)
SESSION_STORE=sqlite
SQLITE_PATH=./data/rag.db
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=collegerag
RETENTION_DAYS=90

# Cache (memory or redis)
CACHE_BACKEND=memory
REDIS_URL=
CACHE_TTL_SECONDS=86400

# Rate limits & token budget
RATE_LIMIT_PER_MINUTE=20
GLOBAL_RATE_LIMIT_PER_MINUTE=300
DAILY_TOKEN_BUDGET=2000000

# Admin auth (api_key or entra)
ADMIN_AUTH_MODE=api_key
ADMIN_API_KEY=replace-with-a-long-random-secret
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ADMIN_ROLE=RAG.Admin
CLIENT_ID_SALT=replace-with-a-random-secret

